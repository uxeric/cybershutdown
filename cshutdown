def gather_info():
    if os.environ.get("CSHUTDOWN_DEMO"):
        return demo_info()
    info = {"host": socket.gethostname().upper(), "kernel": os.uname().release, "procs": []}
    try:
        info["user"] = getpass.getuser()
    except Exception:
        info["user"] = "choom"
    try:
        with open("/proc/uptime") as f:
            up = int(float(f.read().split()[0]))
        info["uptime"] = "%d:%02d:%02d" % (up // 3600, up % 3600 // 60, up % 60)
    except OSError:
        info["uptime"] = "??:??:??"
    procs = []
    for d in os.listdir("/proc"):
        if d.isdigit():
            try:
                with open("/proc/%s/comm" % d) as f:
                    procs.append((int(d), f.read().strip()))
            except OSError:
                pass
    info["procs"] = procs
    try:
        info["tty"] = os.ttyname(0)
    except OSError:
        info["tty"] = "/dev/null"
    return info


