HALF = {(False, False): " ", (True, False): "▀", (False, True): "▄", (True, True): "█"}


class Big:
    """Block-font text as rows of cells, scaled and sheared into an italic.

    ph=0.5 packs two pixel rows into each cell with half blocks, which keeps
    pixels square at the smallest size. A newline stacks centred lines.
    """

    def __init__(self, text, pw=1, ph=1):
        lines = []
        for part in text.split("\n"):
            px = [""] * 5
            for k, c in enumerate(part):
                g = FONT.get(c, FONT["?"])
                for r in range(5):
                    px[r] += g[r] + ("." if k < len(part) - 1 else "")
            lines.append(px)
        width = max(len(px[0]) for px in lines)
        bitmap = []
        for i, px in enumerate(lines):
            if i:
                bitmap.append("." * width)
            pad = (width - len(px[0])) // 2
            bitmap.extend(("." * pad + r).ljust(width, ".") for r in px)
        bitmap = ["".join(c * pw for c in r) for r in bitmap]
        if ph == 0.5:
            if len(bitmap) % 2:
                bitmap.append("." * len(bitmap[0]))
            rows = ["".join(HALF[a == "#", b == "#"] for a, b in zip(top, bot)) for top, bot in zip(bitmap[0::2], bitmap[1::2])]
        else:
            rows = []
            for r in bitmap:
                rows.extend([r.replace("#", "█").replace(".", " ")] * ph)
        self.rows = rows
        self.h = len(rows)
        self.shear = [int((self.h - 1 - r) * 0.5 * pw / ph) for r in range(self.h)]
        self.w = len(rows[0]) + self.shear[0]


def fit_big(texts, max_w, max_h, scales):
    for text in texts:
        for pw, ph in scales:
            b = Big(text, pw, ph)
            if b.w <= max_w and b.h <= max_h:
                return b
    return None


# ── frame buffer ─────────────────────────────────────────────────────────────
_FG, _BG = {}, {}


def fg_esc(c):
    s = _FG.get(c)
    if s is None:
        s = _FG[c] = "\x1b[38;2;%d;%d;%dm" % rgb(c)
    return s


def bg_esc(c):
    s = _BG.get(c)
    if s is None:
        s = _BG[c] = "\x1b[48;2;%d;%d;%dm" % rgb(c)
    return s


class Screen:
    def __init__(self, fd):
        self.fd = fd
        self.w = self.h = self.n = 0
        self.ch = self.fg = self.bg = []
        self.resize()

    def resize(self):
        try:
            w, h = os.get_terminal_size(self.fd)
        except OSError:
            w, h = 80, 24
        w, h = max(w, 20), max(h, 8)
        if (w, h) == (self.w, self.h):
            return False
        self.w, self.h, self.n = w, h, w * h
        self.pch = self.pfg = self.pbg = None
        self.clear()
        return True

    def clear(self, bg=BG):
        n = self.n
        self.ch = [" "] * n
        self.fg = [WHITE] * n
        self.bg = [bg] * n

    def snapshot(self):
        return (self.w, self.h, self.ch[:], self.fg[:], self.bg[:])

    def restore(self, snap):
        w, h, ch, fg, bg = snap
        if (w, h) != (self.w, self.h):
            return False
        self.ch, self.fg, self.bg = ch[:], fg[:], bg[:]
        return True

    def put(self, x, y, s, fg, bg=None):
        if y < 0 or y >= self.h or not s:
            return
        if x < 0:
            s = s[-x:]
            x = 0
        if x + len(s) > self.w:
            s = s[: self.w - x]
        n = len(s)
        if n <= 0:
            return
        i = y * self.w + x
        self.ch[i : i + n] = list(s)
        self.fg[i : i + n] = [fg] * n
        if bg is not None:
            self.bg[i : i + n] = [bg] * n

    def cell(self, x, y, c, fg, bg=None):
        if 0 <= x < self.w and 0 <= y < self.h:
            i = y * self.w + x
            self.ch[i] = c
            self.fg[i] = fg
            if bg is not None:
                self.bg[i] = bg

    def fill(self, x, y, w, h, c, fg, bg=None):
        for yy in range(y, y + h):
            self.put(x, yy, c * w, fg, bg)

    def flush(self):
        w = self.w
        ch, fg, bg = self.ch, self.fg, self.bg
        pch, pfg, pbg = self.pch, self.pfg, self.pbg
        full = pch is None
        out = ["\x1b[?2026h"]
        cf = cb = -1
        for y in range(self.h):
            a = y * w
            b = a + w
            if not full and ch[a:b] == pch[a:b] and fg[a:b] == pfg[a:b] and bg[a:b] == pbg[a:b]:
                continue
            nxt = -1
            for i in range(a, b):
                c, f, g = ch[i], fg[i], bg[i]
                if not full and c == pch[i] and f == pfg[i] and g == pbg[i]:
                    continue
                if i != nxt:
                    out.append("\x1b[%d;%dH" % (y + 1, i - a + 1))
                if g != cb:
                    out.append(bg_esc(g))
                    cb = g
                if f != cf and c != " ":
                    out.append(fg_esc(f))
                    cf = f
                out.append(c)
                nxt = i + 1
        out.append("\x1b[?2026l")
        data = "".join(out).encode()
        while data:
            k = os.write(self.fd, data)
            data = data[k:]
        # clear() hands out fresh lists every frame, so keeping references is safe
        self.pch, self.pfg, self.pbg = ch, fg, bg


# ── drawing helpers ──────────────────────────────────────────────────────────
def draw_big(scr, x, y, big, color, ghost=False, jitter=None):
    for r, line in enumerate(big.rows):
        yy = y + r
        if yy < 0 or yy >= scr.h:
            continue
        base = x + big.shear[r] + (jitter[r] if jitter else 0)
        col = color(r, big.h) if callable(color) else color
        for c, px in enumerate(line):
            if px != " ":
                scr.cell(base + c, yy, "▓" if ghost and px == "█" else px, col)


def draw_big_rgb(scr, x, y, big, color, split, jitter=None):
    """Chromatic aberration: red and cyan ghosts either side of the main glyphs."""
    if split:
        draw_big(scr, x - split, y, big, RED, True, jitter)
        draw_big(scr, x + split, y, big, CYAN, True, jitter)
    draw_big(scr, x, y, big, color, False, jitter)


def decode(text, f, rnd):
    """Text that resolves left to right out of random glyphs."""
    k = int(len(text) * clamp(f))
    tail = "".join(" " if c == " " else rnd.choice(GLYPHS) for c in text[k:])
    return text[:k] + tail


def box(scr, x, y, w, h, color, label=None, reveal=1.0, label_color=BLACK, label_bg=YELLOW):
    """A HUD frame with notched corners. `reveal` draws the perimeter in."""
    if w < 4 or h < 3:
        return
    r = clamp(reveal)
    tw = int((w - 2) * r)
    th = int((h - 2) * r)
    scr.put(x + 1, y, "─" * tw, color)
    scr.put(x + w - 1 - tw, y + h - 1, "─" * tw, color)
    for k in range(th):
        scr.cell(x, y + 1 + k, "│", color)
        scr.cell(x + w - 1, y + h - 2 - k, "│", color)
    if r >= 1:
        scr.cell(x, y, "┌", color)
        scr.cell(x + w - 1, y, "◣", color)
        scr.cell(x, y + h - 1, "◥", color)
        scr.cell(x + w - 1, y + h - 1, "┘", color)
        if label and w > len(label) + 6:
            scr.put(x + 2, y, " " + label + " ", label_color, label_bg)
            scr.cell(x + 3 + len(label) + 1, y, "◤", label_bg)


def hazard(scr, y, offset, color=YELLOW, bg=BG):
    """One row of slanted hazard stripes."""
    if y < 0 or y >= scr.h:
        return
    pat = ("◢", None, None, "◤", " ", " ")
    for x in range(scr.w):
        k = (x + offset) % 6
        p = pat[k]
        if p is None:
            scr.cell(x, y, " ", color, color)
        else:
            scr.cell(x, y, p, color, bg)


# ── glitch post-processing (mutates the frame buffer in place) ──────────────
def tear(scr, y, hgt, dx):
    w = scr.w
    dx %= w
    if not dx:
        return
    for yy in range(max(0, y), min(scr.h, y + hgt)):
        a = yy * w
        b = a + w
        for arr in (scr.ch, scr.fg, scr.bg):
            row = arr[a:b]
            arr[a:b] = row[-dx:] + row[:-dx]


def corrupt_block(scr, rnd, palette):
    bw = rnd.randint(3, max(4, scr.w // 5))
    bh = rnd.randint(1, 3)
    x = rnd.randrange(scr.w)
    y = rnd.randrange(scr.h)
    col = rnd.choice(palette)
    bgc = rnd.choice((BG, BG, BLOOD, DIM_CYAN, col))
    for yy in range(y, min(scr.h, y + bh)):
        for xx in range(x, min(scr.w, x + bw)):
            scr.cell(xx, yy, rnd.choice(NOISE), col, bgc)


def scatter(scr, rnd, count, palette):
    n = scr.n
    ch, fg = scr.ch, scr.fg
    for _ in range(count):
        i = rnd.randrange(n)
        ch[i] = rnd.choice(NOISE)
        fg[i] = rnd.choice(palette)


def invert_band(scr, y, hgt):
    w = scr.w
    for yy in range(max(0, y), min(scr.h, y + hgt)):
        a = yy * w
        for i in range(a, a + w):
            f, b = scr.fg[i], scr.bg[i]
            if scr.ch[i] == " ":
                scr.bg[i] = f if f != WHITE else RED
            else:
                scr.fg[i], scr.bg[i] = b, f


def tint(scr, color, amt):
    scr.fg = [mix(c, color, amt) for c in scr.fg]
    scr.bg = [mix(c, color, amt * 0.35) for c in scr.bg]


def scanline(scr, y, amt=0.45):
    if 0 <= y < scr.h:
        a = y * scr.w
        for i in range(a, a + scr.w):
            scr.fg[i] = mix(scr.fg[i], WHITE, amt)
            scr.bg[i] = mix(scr.bg[i], DIM_CYAN, amt * 0.5)


def melt(scr, m, drops, rnd):
    """Columns slide down at different speeds; the gap fills with red noise."""
    w, h = scr.w, scr.h
    for x in range(w):
        d = min(h, int(drops[x] * m * m * h * 1.4))
        if d <= 0:
            continue
        heads = (
            [rnd.choice("░▒▓ ") if rnd.random() < m else " " for _ in range(d)],
            [mix(DIM_RED, RED, rnd.random())] * d,
            [BG] * d,
        )
        for arr, head in zip((scr.ch, scr.fg, scr.bg), heads):
            arr[x::w] = head + arr[x::w][: h - d]


def glitch(scr, rnd, g, palette=(RED, CYAN, YELLOW, PINK)):
    """Apply glitch damage scaled by intensity g in [0, 1]."""
    if g <= 0.01:
        return
    for _ in range(int(g * 7)):
        if rnd.random() < g:
            tear(scr, rnd.randrange(scr.h), rnd.randint(1, 3), rnd.randint(-int(2 + 14 * g), int(2 + 14 * g)))
    for _ in range(int(g * g * 9)):
        corrupt_block(scr, rnd, palette)
    scatter(scr, rnd, int(scr.n * 0.012 * g), palette)
    if rnd.random() < g * 0.25:
        invert_band(scr, rnd.randrange(scr.h), rnd.randint(1, 2))


