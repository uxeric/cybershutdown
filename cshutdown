def rgb(c):
    return (c >> 16) & 255, (c >> 8) & 255, c & 255


def mix(a, b, t):
    if t <= 0:
        return a
    if t >= 1:
        return b
    ar, ag, ab = rgb(a)
    br, bg, bb = rgb(b)
    return (int(ar + (br - ar) * t) << 16) | (int(ag + (bg - ag) * t) << 8) | int(ab + (bb - ab) * t)


def clamp(v, lo=0.0, hi=1.0):
    return lo if v < lo else hi if v > hi else v


def ease_out(t):
    return 1 - (1 - clamp(t)) ** 3


